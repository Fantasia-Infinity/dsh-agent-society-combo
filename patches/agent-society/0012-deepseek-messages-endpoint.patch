+import type { Context } from "@deepseek-ai/cordis";
+import type { StreamChunk, TokenUsage } from "@deepseek-ai/dsh-llm";
+import {
+  loadAgentConfig,
+  resolveCredential,
+} from "@agent-society/agent-config";
+import { homedir } from "node:os";
+import { join, resolve } from "node:path";
+import { recordAgentSocietyMetrics } from "./context-metrics.js";
+import { deepSeekMessagesEndpoint } from "./deepseek-endpoint.js";
+
+export const name = "agent-society-config";
+export const inject: string[] = [];
+
+const NON_SECRET_KEYS = [
+  "AGENT_HUB_URL",
+  "AGENT_HUB_USERNAME",
+  "AGENT_HUB_RECEIVE_DISABLED",
+  "AGENT_HUB_DSH_WEB",
+  "AGENT_CREDENTIAL_BACKEND",
+  "AGENT_CREDENTIAL_FILE",
+  "AGENT_PRINCIPAL_ID",
+  "AGENT_PRINCIPAL_NAME",
+  "AGENT_ACTOR_ID",
+  "AGENT_ACTOR_NAME",
+  "AGENT_NODE_ID",
+  "AGENT_NODE_NAME",
+  "AGENT_WORKSPACE_ROOT",
+  "AGENT_REMOTE_BASE_URL",
+  "AGENT_REMOTE_TOOL_POLICY",
+  "AGENT_DSH_PERMISSION_MODE",
+  "AGENT_DSH_MODEL",
+  "AGENT_DSH_PROVIDER",
+  "AGENT_REMOTE_MODEL",
+  "AGENT_SOCIETY_PROVIDER",
+  "AGENT_SOCIETY_MODEL",
+  "AGENT_SOCIETY_HUB_MCP",
+  "AGENT_SOCIETY_TOOL_POLICY",
+  "AGENT_SOCIETY_WEB_PROFILE",
+  "AGENT_SOCIETY_DIRECTORY",
+  "AGENT_SOCIETY_CONTEXT_MODE",
+  "AGENT_SOCIETY_QUESTIONS",
+  "AGENT_SOCIETY_CONTEXT",
+  "AGENT_SOCIETY_SESSION_MODE",
+  "AGENT_SOCIETY_POLL_SECONDS",
+  "AGENT_SOCIETY_LEASE_SECONDS",
+];
+
+const CREDENTIAL_KEYS = [
+  "AGENT_REMOTE_API_KEY",
+  "AGENT_HUB_TOKEN",
+  "AGENT_HUB_PASSWORD",
+  "AGENT_HUB_NODE_TOKEN",
+];
+
+export function apply(ctx: Context): void {
+  const dshHome = resolve(process.env.DSH_HOME?.trim() || join(homedir(), ".dsh"));
+  ctx.on("llm/stream", (_options, next) => observeUsage(dshHome, next));
+  const config = loadAgentConfig({ cwd: process.cwd() });
+  for (const key of NON_SECRET_KEYS) {
+    const value = config.values[key]?.trim();
+    if (value && process.env[key] === undefined) process.env[key] = value;
+  }
+  for (const key of CREDENTIAL_KEYS) {
+    if (process.env[key]?.trim()) continue;
+    const resolved = resolveCredential(key, { config });
+    if (resolved.value) process.env[key] = resolved.value;
+    if (resolved.error) {
+      ctx.logger.warn(
+        "agent-society-config: " +
+          key +
+          " credential unavailable (" +
+          resolved.error +
+          ")",
+      );
+    }
+  }
+  // The native dsh DeepSeek adapter owns these names. The shared AgentSociety
+  // credential/config namespace is resolved first so direct `dsh web` and
+  // Host-launched dsh children receive the same model configuration without
+  // persisting a secret in `$DSH_HOME/.env`.
+  if (!process.env.DEEPSEEK_API_KEY && process.env.AGENT_REMOTE_API_KEY) {
+    process.env.DEEPSEEK_API_KEY = process.env.AGENT_REMOTE_API_KEY;
+  }
+  if (!process.env.DEEPSEEK_BASE_URL && process.env.AGENT_REMOTE_BASE_URL) {
+    process.env.DEEPSEEK_BASE_URL = deepSeekMessagesEndpoint(process.env.AGENT_REMOTE_BASE_URL);
+  }
+  copy("AGENT_HUB_URL", "AGENT_SOCIETY_HUB_URL");
+  copy("AGENT_WORKSPACE_ROOT", "AGENT_SOCIETY_WORKSPACE_ROOT");
+  copy("AGENT_ACTOR_ID", "AGENT_SOCIETY_ACTOR_ID");
+  copy("AGENT_NODE_ID", "AGENT_SOCIETY_NODE_ID");
+  copy("AGENT_PRINCIPAL_ID", "AGENT_SOCIETY_PRINCIPAL_ID");
+  copy("AGENT_PRINCIPAL_NAME", "AGENT_SOCIETY_DISPLAY_NAME");
+  if (!process.env.AGENT_SOCIETY_MODEL) {
+    copy("AGENT_DSH_MODEL", "AGENT_SOCIETY_MODEL");
+    copy("AGENT_REMOTE_MODEL", "AGENT_SOCIETY_MODEL");
+  }
+  if (!process.env.AGENT_SOCIETY_PROVIDER) {
+    copy("AGENT_DSH_PROVIDER", "AGENT_SOCIETY_PROVIDER");
+  }
+  if (!process.env.AGENT_SOCIETY_TOOL_POLICY) {
+    const policy = process.env.AGENT_REMOTE_TOOL_POLICY;
+    if (policy === "read_only") process.env.AGENT_SOCIETY_TOOL_POLICY = "read_only";
+    else if (policy === "no_tools") process.env.AGENT_SOCIETY_TOOL_POLICY = "no_tools";
+    else if (policy === "full") process.env.AGENT_SOCIETY_TOOL_POLICY = "full";
+  }
+  if (!process.env.AGENT_SOCIETY_HUB_TOKEN) {
+    process.env.AGENT_SOCIETY_HUB_TOKEN =
+      process.env.AGENT_HUB_NODE_TOKEN?.trim() ||
+      process.env.AGENT_HUB_TOKEN?.trim() ||
+      "";
+  }
+  if (!process.env.AGENT_SOCIETY_HUB_URL) {
+    process.env.AGENT_SOCIETY_HUB_URL = "";
+  }
+}
+
+function observeUsage(
+  dshHome: string,
+  next: () => AsyncIterable<StreamChunk>,
+): AsyncIterable<StreamChunk> {
+  return (async function* (): AsyncIterable<StreamChunk> {
+    let usage: TokenUsage | undefined;
+    try {
+      for await (const chunk of next()) {
+        if (chunk.type === "usage") usage = chunk.usage;
+        yield chunk;
+      }
+    } finally {
+      if (usage !== undefined) recordAgentSocietyMetrics(dshHome, { usage });
+    }
+  })();
+}
+
+function copy(source: string, target: string): void {
+  if (process.env[target] === undefined && process.env[source]?.trim()) {
+    process.env[target] = process.env[source]!.trim();
+  }
+}
diff --git a/dsh-plugin/src/deepseek-endpoint.ts b/dsh-plugin/src/deepseek-endpoint.ts
new file mode 100644
--- /dev/null
+++ b/dsh-plugin/src/deepseek-endpoint.ts
@@ -0,0 +1,10 @@
+/** Translate legacy official Chat Completions roots to the native Messages root.
+ * Custom gateways and explicit native adapter overrides are left unchanged.
+ */
+export function deepSeekMessagesEndpoint(value: string): string {
+  const root = value.trim().replace(/\/+$/u, "");
+  if (root === "https://api.deepseek.com" || root === "https://api.deepseek.com/v1") {
+    return "https://api.deepseek.com/anthropic";
+  }
+  return value;
+}
diff --git a/dsh-plugin/test/deepseek-endpoint.test.mjs b/dsh-plugin/test/deepseek-endpoint.test.mjs
new file mode 100644
--- /dev/null
+++ b/dsh-plugin/test/deepseek-endpoint.test.mjs
@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { deepSeekMessagesEndpoint } from '../lib/deepseek-endpoint.js';
+
+test('legacy official roots use the Messages endpoint', () => {
+  for (const root of ['https://api.deepseek.com', 'https://api.deepseek.com/', 'https://api.deepseek.com/v1']) {
+    assert.equal(deepSeekMessagesEndpoint(root), 'https://api.deepseek.com/anthropic');
+  }
+});
+
+test('native and custom endpoints remain unchanged', () => {
+  for (const root of ['https://api.deepseek.com/anthropic', 'https://gateway.example/v1', 'http://localhost:3000']) {
+    assert.equal(deepSeekMessagesEndpoint(root), root);
+  }
+});
