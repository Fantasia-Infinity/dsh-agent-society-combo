+ */
+function withShippedPresetRoot(patches: PatchOptions[]): PatchOptions[] {
+  const rows = new Map<string, PatchOptions>()
+  for (const row of composeEntries([patches])) {
+    if (typeof row.id === 'string') rows.set(row.id, row)
+  }
+  const roster = rows.get('agent-presets')
+  if (roster === undefined) return patches
+  const config = roster.config
+  const preservedConfig = config !== null && typeof config === 'object' && !Array.isArray(config)
+    ? config as Record<string, unknown>
+    : {}
+  return [
+    ...patches,
+    {
+      id: 'agent-presets',
+      config: {
+        ...preservedConfig,
+        roots: [{ path: SHIPPED_PRESET_ROOT, trust: 'system' }],
+      },
+    },
+  ]
