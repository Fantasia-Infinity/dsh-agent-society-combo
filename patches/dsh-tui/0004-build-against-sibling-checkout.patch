 # declarations) with the DSH checkout's TypeScript. Dependency resolution
 # mirrors dsh-vision: node_modules holds symlinks into the checkout, so tsc
 # type-checks against the same vendored/workspace packages the running dsh
-# ships. Requires a DSH checkout ($DSH_HOME/source/current, ~/.dsh/..., or
-# the `dsh` bin resolving into one).
+# ships. Set DSH_CHECKOUT to use a sibling source checkout directly; without
+# it, retain the installed-source discovery used by the published workflow.
 set -eu
 
 ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
@@ -12,7 +12,9 @@ cd "$ROOT"
 
 # --- Locate the DSH checkout -------------------------------------------
 CHECKOUT=""
-if [ -n "${DSH_HOME:-}" ] && [ -d "$DSH_HOME/source/current" ]; then
+if [ -n "${DSH_CHECKOUT:-}" ] && [ -d "$DSH_CHECKOUT/packages" ]; then
+  CHECKOUT="$DSH_CHECKOUT"
+elif [ -n "${DSH_HOME:-}" ] && [ -d "$DSH_HOME/source/current" ]; then
   CHECKOUT="$DSH_HOME/source/current"
 elif [ -d "${HOME:-}/.dsh/source/current" ]; then
   CHECKOUT="$HOME/.dsh/source/current"
@@ -48,13 +50,53 @@ mkdir -p node_modules/@deepseek-ai node_modules/@standard-schema
 if [ ! -e node_modules/@types ]; then
   ln -sfn "$CHECKOUT/node_modules/@types" node_modules/@types
 fi
-link_pkg cordis vendor/cordis
-link_pkg cosmokit vendor/cosmokit
-link_pkg schemastery vendor/schemastery
-link_pkg @deepseek-ai/dsh-agent packages/core/agent
-link_pkg @deepseek-ai/dsh-commands packages/ui/commands
-link_pkg @deepseek-ai/dsh-llm packages/llm/llm
-link_pkg @deepseek-ai/dsh-session packages/core/session
+if [ -n "${DSH_CHECKOUT:-}" ]; then
+  # A sibling checkout is a complete pnpm workspace. Link every scoped DSH
+  # package so local source versions cannot be mixed with npm releases.
+  find "$CHECKOUT/packages" "$CHECKOUT/vendor" "$CHECKOUT/apps" \
+    -type f -name package.json -print | while IFS= read -r manifest; do
+    package_name=$(node -e 'const fs = require("node:fs"); const p = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); process.stdout.write(p.name ?? "")' "$manifest")
+    case "$package_name" in
+      @deepseek-ai/*)
+        package_dir=${manifest%/package.json}
+        package_dir=${package_dir#"$CHECKOUT"/}
+        link_pkg "$package_name" "$package_dir"
+        ;;
+    esac
+  done
+else
+  link_pkg @deepseek-ai/cordis vendor/cordis
+  link_pkg @deepseek-ai/cosmokit vendor/cosmokit
+  link_pkg @deepseek-ai/schemastery vendor/schemastery
+  link_pkg @deepseek-ai/dsh-agent packages/core/agent
+  link_pkg @deepseek-ai/dsh-commands packages/interaction/commands
+  link_pkg @deepseek-ai/dsh-llm packages/llm/llm
+  link_pkg @deepseek-ai/dsh-session packages/core/session
+fi
+
+# dsh-working-activity is a plain npm package (not part of the harness
+# workspace): its d.ts imports @deepseek-ai/dsh-session (and peers) through
+# its own .pnpm copy, which would mix npm rc.7 types with the patched
+# source. Point its scoped deps at the root links (already patched source).
+wa_dir=$(find "node_modules/.pnpm" -maxdepth 1 -type d -iname 'dsh-working-activity@*' 2>/dev/null | head -1)
+if [ -n "$wa_dir" ] && [ -d "$wa_dir/node_modules/@deepseek-ai" ]; then
+  for scoped in "$wa_dir"/node_modules/@deepseek-ai/*; do
+    name=$(basename "$scoped")
+    if [ -e "node_modules/@deepseek-ai/$name" ]; then
+      rm -f "$scoped"
+      ln -s "$(pwd)/node_modules/@deepseek-ai/$name" "$scoped"
+    fi
+  done
+fi
+
+# dsh-auth is shipped as a TUI submodule and is linked into the root
+# node_modules tree by pnpm. Its generated declarations are required by
+# src/oauth.ts, but source-mode installs intentionally skip lifecycle scripts.
+if [ -f "$ROOT/dsh-auth/package.json" ]; then
+  echo "=== Building dsh-auth ==="
+  pnpm --dir "$ROOT/dsh-auth" install --frozen-lockfile --ignore-scripts >/dev/null
+  pnpm --dir "$ROOT/dsh-auth" run build
+fi
 
 # @standard-schema/spec: external npm types referenced by cordis/schemastery
 # declarations, hoisted only inside the pnpm store.
@@ -65,6 +107,13 @@ else
   echo "build: @standard-schema/spec not found in pnpm store; skipLibCheck may still cover it" >&2
 fi
 
+# v0.8.1+ vendors @dsh-std as a nested pnpm workspace; its packages must
+# be compiled before tsc can resolve @dsh-std/* type declarations.
+if [ -d "$ROOT/vendor/dsh-std" ] && [ -f "$ROOT/vendor/dsh-std/package.json" ]; then
+  echo "=== Building vendor/dsh-std ==="
+  (cd "$ROOT/vendor/dsh-std" && pnpm install --frozen-lockfile --ignore-scripts >/dev/null && pnpm -r build)
+fi
+
 echo "=== Compiling src → lib/types ($("$TSC" --version)) ==="
 "$TSC" -p tsconfig.json
